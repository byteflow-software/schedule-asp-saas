# === Backend (.NET) ===

# Environment
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=scheduly;Username=scheduly;Password=scheduly_pass

# JWT
Jwt__Secret=SuperSecretKeyForDevelopment_MustBeAtLeast32Characters!
Jwt__Issuer=Scheduly
Jwt__Audience=Scheduly
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7

# CORS (comma-separated origins, empty = AllowAnyOrigin)
ALLOWED_ORIGINS=http://localhost:4200

# Email SMTP
Email__Host=localhost
Email__Port=1025
Email__From=noreply@scheduly.com
Email__FromName=Scheduly
Email__EnableSsl=false
Email__Username=
Email__Password=

# Coverage Report Auth (Development only)
Coverage__Username=dev
Coverage__Password=dev123

# === Frontend (Vercel) ===
# Set in Vercel project Settings → Environment Variables
API_URL=https://your-railway-url.up.railway.app
